{
  "name": "easydb-local",
  "version": "1.0.0",
  "description": "EasyDB - Lightweight NoSQL database on Cloudflare Workers and D1",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:new": "wrangler d1 migrations create DB"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3",
    "wrangler": "^4.151.2"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/storage-blob": "^12.34.0"
  }
}
